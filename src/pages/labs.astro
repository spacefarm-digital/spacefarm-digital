---
// Spacefarm Labs: the report behind the cover on the home page (components/Labs.astro), laid out
// like a 1960s technical report. An orange cover, then manila paper with section numbers hanging
// in the margin, ruled tables and line-drawn plates. In the dark theme the paper goes black and the
// ink orange; the cover stays as printed. Shared pieces are in styles/labs.css; the two tables are
// content/labs-areas.yml and content/labs-notes.yml.
import { getCollection } from 'astro:content';
import '../styles/labs.css';
import Base from '../layouts/Base.astro';
import Logo from '../assets/logo.svg';
import FigReach from '../components/labs/FigReach.astro';
import FigAcuity from '../components/labs/FigAcuity.astro';
import FigFocus from '../components/labs/FigFocus.astro';

const home = import.meta.env.BASE_URL;
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const areas = (await getCollection('labsAreas')).sort(byOrder);
const notes = (await getCollection('labsNotes')).sort(byOrder);

const report = 'SFL TR-001';
const sections = [
  { n: '1.0', title: 'Purpose', id: 'purpose' },
  { n: '2.0', title: 'Research areas', id: 'areas' },
  { n: '3.0', title: 'Technical notes', id: 'notes' },
  { n: '4.0', title: 'Correspondence', id: 'correspondence' },
];
const [purpose, research, technical, correspondence] = sections;
const noteNo = (order: number) => `SFL TN-${String(order + 1).padStart(3, '0')}`;
---

<Base
  title="Spacefarm Labs: Accessibility research"
  description="Spacefarm Labs is our initiative for advancing human-computer interaction and accessibility."
  themeColor="#ff4f00"
>
  <div class="labs">
    <a class="skip labs-cta" href="#report">
      Skip to the report
    </a>

    <header class="cover">
      <div class="wrap">
        <div class="labs-strip">
          <a class="home labs-focus" href={home} aria-label="Spacefarm, home">
            <span class="logo">
              <Logo />
            </span>
            spacefarm
          </a>
          <span>
            Technical report <b>{report}</b>
          </span>
        </div>
        <h1>
          Spacefarm
          <br />
          Labs
        </h1>
        <div class="under">
          <div>
            <p class="labs-subject">Accessibility research</p>
            <p class="abstract">
              Our initiative for advancing human-computer interaction and accessibility. We study
              how people with different bodies, senses and minds use computers, and publish what we
              learn.
            </p>
          </div>
          <dl class="block">
            <div>
              <dt>Report no.</dt>
              <dd>{report}</dd>
            </div>
            <div>
              <dt>Issued</dt>
              <dd>November 2026</dd>
            </div>
            <div>
              <dt>Subject</dt>
              <dd>Human-computer interaction</dd>
            </div>
            <div>
              <dt>Distribution</dt>
              <dd>Unlimited</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <main class="wrap" id="report" tabindex="-1">
      <section class="sec margin" aria-labelledby="summary-h">
        <h2 class="num" id="summary-h">
          Summary
        </h2>
        <div class="body">
          <p class="lead">
            Most software is designed for one kind of person on a good day. Labs is where we measure
            what happens to everyone else, and work out what to build instead.
          </p>
        </div>
      </section>

      <nav class="sec margin" aria-labelledby="contents-h">
        <h2 class="num" id="contents-h">
          Contents
        </h2>
        <ol class="toc body">
          {sections.map((s) => (
            <li>
              <a class="labs-focus" href={`#${s.id}`}>
                <span class="n">{s.n}</span>
                <span class="t">{s.title}</span>
                <span class="dots" aria-hidden="true" />
                <span class="n" aria-hidden="true">
                  {parseInt(s.n)}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <section class="sec" id={purpose.id} aria-labelledby="purpose-h">
        <h2 id="purpose-h">
          <span class="num">{purpose.n}</span> <span>{purpose.title}</span>
        </h2>
        <div class="body">
          <p>
            In the 1960s, the people who put crews into spacecraft had a name for the study of how a
            person and a machine fit together. They called it human factors, and they measured
            everything: how far an arm reaches in a pressure suit, how small a label can be and
            still be read in a shaking cabin.
          </p>
          <p>
            We think the same care belongs in everyday software. Spacefarm Labs runs small,
            practical studies, tries the findings in our own apps, and writes them up so anyone can
            use them.
          </p>
        </div>
        <div class="plates">
          <figure>
            <div class="art">
              <FigReach id="plate-reach" />
            </div>
            <figcaption class="labs-caption">
              <b>Fig. 1.</b> One-handed thumb reach. A, natural. B, stretch. C, out of reach.
            </figcaption>
          </figure>
          <figure>
            <div class="art">
              <FigAcuity />
            </div>
            <figcaption class="labs-caption">
              <b>Fig. 2.</b> Type size against acuity. Rows 1 to 6, largest to smallest.
            </figcaption>
          </figure>
          <figure>
            <div class="art">
              <FigFocus />
            </div>
            <figcaption class="labs-caption">
              <b>Fig. 3.</b> Focus order through a form, stops 1 to 5. Stop 2 has focus.
            </figcaption>
          </figure>
        </div>
      </section>

      <!--
        The tables carry explicit ARIA roles because on phones their rows are restacked with
        display: grid, and a table whose display changes loses its semantics in some browsers.
      -->
      <section class="sec" id={research.id} aria-labelledby="areas-h">
        <h2 id="areas-h">
          <span class="num">{research.n}</span> <span>{research.title}</span>
        </h2>
        <div class="body wide">
          <table role="table" aria-labelledby="areas-h">
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">
                  No.
                </th>
                <th role="columnheader" scope="col">
                  Area
                </th>
                <th role="columnheader" scope="col">
                  What we are asking
                </th>
                <th role="columnheader" scope="col">
                  Status
                </th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {areas.map(({ data }) => (
                <tr role="row">
                  <td role="cell" class="no mono">
                    2.{data.order + 1}
                  </td>
                  <th role="rowheader" scope="row" class="main">
                    {data.area}
                  </th>
                  <td role="cell" class="text">
                    {data.asks}
                  </td>
                  <td role="cell" class="state mono">
                    {data.status}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec" id={technical.id} aria-labelledby="notes-h">
        <h2 id="notes-h">
          <span class="num">{technical.n}</span> <span>{technical.title}</span>
        </h2>
        <div class="body wide">
          <table role="table" aria-labelledby="notes-h">
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">
                  No.
                </th>
                <th role="columnheader" scope="col">
                  Date
                </th>
                <th role="columnheader" scope="col">
                  Title
                </th>
                <th role="columnheader" scope="col">
                  State
                </th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {notes.map(({ data }) => (
                <tr role="row">
                  <td role="cell" class="no mono nowrap">
                    {noteNo(data.order)}
                  </td>
                  <td role="cell" class="text mono nowrap">
                    {data.date}
                  </td>
                  <th role="rowheader" scope="row" class="main">
                    {data.link ? <a href={data.link}>{data.title}</a> : data.title}
                  </th>
                  <td role="cell" class="state mono">
                    {data.state}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec" id={correspondence.id} aria-labelledby="correspondence-h">
        <h2 id="correspondence-h">
          <span class="num">{correspondence.n}</span>
          <span>{correspondence.title}</span>
        </h2>
        <div class="body">
          <p>
            Research is better with company. If you work on accessibility, live with a disability,
            or would like to take part in a study, write to us.
          </p>
          <a class="labs-cta" href="mailto:hello@spacefarm.digital">
            hello@spacefarm.digital
          </a>
        </div>
      </section>

      <footer class="labs-strip foot">
        <span>{report}</span>
        <span class="labs-stamp">Distribution unlimited</span>
        <span>Page 1 of 1</span>
      </footer>
    </main>
  </div>
</Base>

<style>
  .labs {
    --paper: #f2ecdf;
    --ink: #24231f;
    --head: var(--labs-black);
    --rule: var(--labs-black);
    --rule-soft: rgb(11 11 12 / 0.22);
    /* The paper the figures' callout discs are punched out of */
    --fig-bg: var(--paper);
    position: relative;
    min-height: 100vh;
    color: var(--ink);
    background: var(--paper);
  }
  .labs ::selection {
    color: var(--labs-orange);
    background: var(--labs-black);
  }
  @media (prefers-color-scheme: dark) {
    .labs {
      --paper: #000;
      --ink: #d2d2dc;
      --head: var(--labs-orange);
      --rule: var(--labs-orange);
      --rule-soft: rgb(255 255 255 / 0.2);
    }
    main ::selection {
      color: var(--labs-black);
      background: var(--labs-orange);
    }
  }
  .wrap {
    max-width: 50rem;
    margin: 0 auto;
    padding: 0 1.1rem;
  }
  @media (min-width: 48rem) {
    .wrap {
      padding: 0 2rem;
    }
  }
  main:focus {
    outline: 0;
  }

  /* Off the page until it has keyboard focus */
  .skip {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
    background: var(--labs-orange);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }

  /* The cover */
  .cover {
    padding-bottom: 2.2rem;
    color: var(--labs-black);
    background: var(--labs-orange);
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .home .logo {
    width: 0.8em;
    height: 0.8em;
  }
  h1 {
    margin: 2rem 0 1.6rem -0.05em;
    font-family: var(--font-head);
    font-size: clamp(2.6rem, 17.5vw, 9rem);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.04em;
  }
  .under {
    display: grid;
    gap: 1.6rem;
  }
  @media (min-width: 48rem) {
    .under {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 3rem;
      align-items: end;
    }
  }
  .abstract {
    max-width: 24rem;
    margin: 1rem 0 0;
    line-height: 1.4;
    text-wrap: pretty;
  }
  /* The title block, as on an engineering drawing */
  .block {
    margin: 0;
    border: 2px solid currentColor;
    font-family: var(--labs-mono);
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.04em;
  }
  .block div {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
  }
  .block div + div {
    border-top: 1px solid currentColor;
  }
  .block dt,
  .block dd {
    margin: 0;
    padding: 0.35rem 0.55rem;
  }
  .block dt {
    border-right: 1px solid currentColor;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /*
   * The document. Each section is a rule, a heading and a body; from tablets up the heading's
   * number hangs in a margin column and everything else lines up on the second column.
   */
  main {
    --margin: 7rem;
    --gutter: 1rem;
    padding-top: 0.6rem;
  }
  .sec {
    padding: 1.6rem 0 1.2rem;
    border-top: 2px solid var(--rule);
    scroll-margin-top: 0.5rem;
  }
  .sec:first-child {
    border-top: 0;
  }
  .sec h2 {
    margin: 0 0 0.9rem;
    color: var(--head);
    font-family: var(--font-head);
    font-size: clamp(1.4rem, 9vw, var(--text-f3));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .num,
  .sec h2.num {
    display: block;
    margin: 0 0 0.6rem;
    color: var(--head);
    font-family: var(--labs-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .body {
    max-width: 30rem;
  }
  .body.wide {
    max-width: none;
  }
  .body p {
    text-wrap: pretty;
  }
  @media (min-width: 48rem) {
    .sec {
      display: grid;
      grid-template-columns: var(--margin) minmax(0, 1fr);
      column-gap: var(--gutter);
      padding: 2rem 0 1.4rem;
    }
    .sec h2 {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: var(--margin) minmax(0, 1fr);
      column-gap: var(--gutter);
      align-items: baseline;
    }
    .sec h2 .num {
      margin: 0;
    }
    .sec > .body,
    .sec > .plates {
      grid-column: 2;
    }
    /* Summary and Contents: the heading is only the margin label, beside its body */
    .sec.margin h2.num {
      display: block;
      grid-column: 1;
      margin: 0;
      padding-top: 0.35rem;
    }
  }
  .lead {
    color: var(--head);
    font-family: var(--font-head);
    font-size: var(--text-f4);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* Contents, with dot leaders */
  .toc {
    font-family: var(--labs-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .toc a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.28rem 0;
  }
  .toc a:hover .t {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .toc .n {
    color: var(--head);
    font-weight: 600;
  }
  .toc .dots {
    flex: 1;
    border-bottom: 2px dotted var(--rule-soft);
    transform: translateY(-0.25em);
  }

  /* Plates */
  .plates {
    display: grid;
    gap: 1.6rem;
    margin: 1rem 0 0.8rem;
    color: var(--head);
  }
  @media (min-width: 48rem) {
    .plates {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.2rem;
      margin-top: 1.4rem;
    }
  }
  .plates figure {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .plates .art {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 0.8rem;
    border: 1.5px solid var(--rule);
  }
  .plates .art :global(svg) {
    max-width: 13rem;
  }
  .plates figcaption {
    margin-top: 0.55rem;
    color: var(--ink);
  }
  .plates figcaption b {
    color: var(--head);
  }

  /* Ruled tables */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    line-height: 1.35;
  }
  thead th {
    padding: 0.4rem 0.8rem 0.4rem 0;
    border-top: 2px solid var(--rule);
    border-bottom: 2px solid var(--rule);
    color: var(--head);
    font-family: var(--labs-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
  }
  tbody th,
  tbody td {
    padding: 0.6rem 0.8rem 0.6rem 0;
    border-bottom: 1px solid var(--rule-soft);
    text-align: left;
    vertical-align: top;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 2px solid var(--rule);
  }
  tbody th {
    color: var(--head);
    font-weight: 600;
  }
  tbody th a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  thead th:last-child,
  tbody td:last-child {
    padding-right: 0;
  }
  .mono {
    font-family: var(--labs-mono);
    font-size: 0.65rem;
    font-weight: 500;
    line-height: 1.75;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .nowrap {
    white-space: nowrap;
  }
  /* On phones each row becomes a small card: number and state on one line, then the rest */
  @media (max-width: 47.99rem) {
    table,
    tbody {
      display: block;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    tbody {
      border-top: 2px solid var(--rule);
      border-bottom: 2px solid var(--rule);
    }
    tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'no state'
        'main main'
        'text text';
      gap: 0.1rem 0.8rem;
      padding: 0.7rem 0 0.8rem;
      border-bottom: 1px solid var(--rule-soft);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody th,
    tbody td,
    tbody tr:last-child th,
    tbody tr:last-child td {
      display: block;
      padding: 0;
      border: 0;
    }
    .no {
      grid-area: no;
    }
    .state {
      grid-area: state;
    }
    .main {
      grid-area: main;
      font-size: 1rem;
    }
    .text {
      grid-area: text;
    }
  }

  .labs-cta {
    --cta-ink: var(--head);
    --cta-ground: var(--paper);
    margin-top: 0.3rem;
    letter-spacing: 0.04em;
  }
  .skip.labs-cta {
    --cta-ink: var(--labs-black);
    --cta-ground: var(--labs-orange);
    margin: 0;
  }
  .labs-strip.foot {
    margin-top: 3rem;
    padding-bottom: 2.4rem;
    color: var(--head);
  }
</style>
