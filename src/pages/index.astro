---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Apps from '../components/Apps.astro';
import WorkTeaser from '../components/WorkTeaser.astro';
import Services from '../components/Services.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Illustration from '../components/Illustration.astro';
import PaperShader from '../components/PaperShader.astro';

// "What we do" is hidden for now; flip to true to show it again.
const showServices = false;
// The old work card is hidden too. Its page lives at pages/_timeline.astro, which the leading
// underscore keeps out of the build; rename it back to timeline.astro and flip this to show both.
const showOldWork = false;
---

<Base>
  <PaperShader preset="paper" class="paper" />
  <main class="relative z-2">
    <div class="mx-auto max-w-3xl px-4">
      <Hero />
      <Apps />
      {showOldWork && <WorkTeaser />}
      {showServices && <Services />}
      <Team />
      <Contact />
      <Illustration />
    </div>
  </main>
</Base>
