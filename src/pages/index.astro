---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Apps from '../components/Apps.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Illustration from '../components/Illustration.astro';
import PaperShader from '../components/PaperShader.astro';
---

<Base>
  <PaperShader preset="paper" class="paper" />
  <main class="relative z-2">
    <div class="mx-auto max-w-3xl px-4">
      <Hero />
      <Apps />
      <Projects />
      <Services />
      <Team />
      <Contact />
      <Illustration />
    </div>
  </main>
</Base>
