---
// Our apps: a grid in the page column, four up from tablets and two on phones, each a big floating icon over a bold
// name and one-liner.
// The one-liners paraphrase each app's site, or for Sunlight its README.
import { Image } from 'astro:assets';
import PaperShader from './PaperShader.astro';

type App = {
  id: 'wtheic' | 'agents' | 'sunlight' | 'chopchop';
  name: string;
  pitch: string;
  link?: string;
};

// App icons, by app: src/assets/apps/<id>-icon.png, cropped to the icon's edge. An app without one shows its Paper Shader
// scene in an icon-shaped tile instead, which still reacts to hover.
const icons = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*-icon.png', { eager: true }),
  ).map(([path, mod]) => [path.split('/').pop()!.replace('-icon.png', ''), mod.default]),
);

const apps: App[] = [
  {
    id: 'wtheic',
    name: 'wtHEIC',
    pitch: 'Drag or paste a HEIC into any app and a JPG lands there instead.',
    link: 'https://wtheic.com',
  },
  {
    id: 'agents',
    name: 'Agents',
    pitch: 'A native home for your coding agents on Mac, iPhone and Apple Watch.',
    link: 'https://agentsapp.net',
  },
  {
    id: 'sunlight',
    name: 'Sunlight',
    pitch: 'An infinite, zoomable canvas of your real Mac windows and widgets.',
  },
  {
    id: 'chopchop',
    name: 'Chop-Chop',
    pitch: 'Tell it what is in your kitchen and it cooks up the recipe, nutrition and all.',
    link: 'https://chop-chop.app',
  },
];

---

<section class="mb-8">
  <h2 class="label text-f5 mb-4 inline-block bg-selection px-2 py-1 leading-normal font-semibold">
    Our apps
  </h2>
  <ul class="mb-4 grid grid-cols-2 gap-x-5 gap-y-8 sm:gap-x-8 sm:gap-y-10 md:grid-cols-4">
    {apps.map((app) => {
      const icon = icons[app.id];
      const Row = app.link ? 'a' : 'div';
      return (
        <li>
          <Row
            class={`app app-${app.id}`}
            data-app={app.id}
            href={app.link}
            target={app.link ? '_blank' : undefined}
            rel={app.link ? 'noopener' : undefined}
            tabindex={app.link ? undefined : 0}
          >
            <div class="icon" aria-hidden="true">
              {icon ? (
                <Image src={icon} alt="" width={132} densities={[1, 2, 3]} class="icon-img" />
              ) : (
                <div class="tile">
                  <PaperShader preset={app.id} class="scene" />
                  <span class="cut" />
                </div>
              )}
            </div>
            <div class="copy">
              <h3 class="font-head text-f5 sm:text-f4 mb-1 leading-[1.1] font-bold whitespace-nowrap text-black">{app.name}</h3>
              <p class="mb-0 text-[0.85rem] leading-snug text-ink sm:text-base">{app.pitch}</p>
            </div>
          </Row>
        </li>
      );
    })}
  </ul>
</section>

<style>
  /* A grid cell: the icon floats on its own with the copy beneath it */
  .app {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    border-radius: var(--radius-card);
  }
  .app:focus-visible {
    outline: 3px solid var(--color-spacefarm);
    outline-offset: 6px;
  }
  .icon {
    flex: none;
    width: 100%;
    max-width: 4.5rem;
    aspect-ratio: 1;
    animation: float 6s ease-in-out infinite;
  }
  li:nth-child(even) .icon {
    animation-delay: -3s;
  }
  @media (min-width: 34rem) {
    .icon {
      max-width: 6rem;
    }
  }
  .icon-img,
  .tile {
    width: 100%;
    height: 100%;
    border-radius: 22.5%;
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.06),
      0 24px 48px -16px rgb(61 62 64 / 0.35);
    transition:
      transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile {
    position: relative;
    overflow: hidden;
    background: #fff;
  }
  .app:hover .icon-img,
  .app:focus-visible .icon-img,
  .app:hover .tile,
  .app:focus-visible .tile {
    transform: translateY(-6px) scale(1.04) rotate(-2deg);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.06),
      0 36px 60px -16px rgb(61 62 64 / 0.4);
  }
  .tile :global(.scene) {
    position: absolute;
    inset: 0;
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cut {
    display: none;
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  /* wtHEIC: a dithered photo that snaps into focus. The CSS gradient is the no-WebGL stand-in. */
  .app-wtheic :global(.scene) {
    background: radial-gradient(circle at 60% 40%, var(--color-selection), #fff 70%);
  }
  .app-wtheic:hover :global(.scene),
  .app-wtheic:focus-visible :global(.scene) {
    transform: scale(1.04);
  }

  /* Agents: gooey blobs in the brand purple that multiply on hover */
  .app-agents :global(.scene) {
    background:
      radial-gradient(circle at 30% 50%, #7080d4 0, transparent 35%),
      radial-gradient(circle at 70% 45%, var(--color-spacefarm) 0, transparent 38%), #f7f8fa;
  }

  /* Sunlight: rays from the top right that brighten on hover, and the card warms with them */
  .app-sunlight :global(.scene) {
    background: radial-gradient(circle at 85% 0%, var(--color-kirtan), #fff6d6 40%, #fff 75%);
  }
  .app-sunlight:hover .tile,
  .app-sunlight:focus-visible .tile {
    box-shadow:
      var(--shadow-card-hover),
      0 24px 60px -24px rgb(254 213 79 / 0.55);
  }

  /* Chop-Chop: sharp panels, and a neon cut that sweeps across on hover */
  .app-chopchop :global(.scene) {
    background: linear-gradient(
      100deg,
      #fff 30%,
      var(--color-medium) 30% 50%,
      var(--color-spacefarm) 50% 70%,
      #fff 70%
    );
  }
  .app-chopchop .cut {
    display: block;
    position: absolute;
    top: -20%;
    left: -10%;
    width: 3px;
    height: 140%;
    background: var(--color-medium);
    box-shadow:
      0 0 8px var(--color-medium),
      0 0 24px rgb(92 255 160 / 0.8);
    transform: rotate(18deg) translateX(-20px);
    opacity: 0;
  }
  .app-chopchop:hover .cut,
  .app-chopchop:focus-visible .cut {
    animation: chop 550ms cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  .app-chopchop:hover :global(.scene),
  .app-chopchop:focus-visible :global(.scene) {
    transform: skewX(-2deg) scale(1.03);
  }
  @keyframes chop {
    0% {
      opacity: 0;
      transform: rotate(18deg) translateX(-20px);
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: rotate(18deg) translateX(calc(100% + 24rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon {
      animation: none;
    }
    .icon-img,
    .tile,
    :global(.scene) {
      transition: none;
    }
    .app-chopchop:hover .cut,
    .app-chopchop:focus-visible .cut {
      animation: none;
      opacity: 0.9;
      transform: rotate(18deg) translateX(10rem);
    }
  }
</style>

<script>
  // Hover and focus retune each card's shader. PaperShader.astro mounts them; this only tweens the
  // uniforms it registered under `app` presets, and does nothing when the shader did not mount.
  import { ShaderMount, isPaperShaderElement } from '@paper-design/shaders';
  import { appHover } from './app-shaders';

  const stillness = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  type Tween = { frame: number };

  for (const card of document.querySelectorAll<HTMLElement>('[data-app]')) {
    const scene = card.querySelector<HTMLElement>('[data-paper-shader]');
    const hover = appHover[card.dataset.app ?? ''];
    if (!scene || !hover) continue;
    let tween: Tween | null = null;
    const current = { ...hover.off };

    const settle = (active: boolean) => {
      if (!isPaperShaderElement(scene) || !scene.paperShaderMount) return;
      const mount: ShaderMount = scene.paperShaderMount;
      const to = active ? hover.on : hover.off;
      const from = { ...current };
      const speed = active ? hover.speedOn : hover.speedOff;
      mount.setSpeed(stillness ? 0 : speed);
      if (tween) cancelAnimationFrame(tween.frame);
      if (stillness) {
        Object.assign(current, to);
        mount.setUniforms(to);
        return;
      }
      const start = performance.now();
      const duration = 500;
      const step = (now: number) => {
        const t = ease(Math.min(1, (now - start) / duration));
        const next: Record<string, number> = {};
        for (const key of Object.keys(to)) next[key] = from[key] + (to[key] - from[key]) * t;
        Object.assign(current, next);
        mount.setUniforms(next);
        if (t < 1) tween = { frame: requestAnimationFrame(step) };
      };
      tween = { frame: requestAnimationFrame(step) };
    };

    card.addEventListener('pointerenter', () => settle(true));
    card.addEventListener('pointerleave', () => settle(false));
    card.addEventListener('focus', () => settle(true));
    card.addEventListener('blur', () => settle(false));
  }
</script>
