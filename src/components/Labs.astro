---
// Spacefarm Labs on the home page: the cover of a 1960s technical report, black ink on
// International Orange, linking to the report itself at /labs/. It is a printed object, so it
// keeps its colours in the dark theme and its corners square. Shared pieces are in styles/labs.css.
import '../styles/labs.css';
import FigKeyboard from './labs/FigKeyboard.astro';
import FigVisemes from './labs/FigVisemes.astro';

const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/labs/`;
---

<section class="labs-cover mb-16 sm:mb-24" aria-labelledby="labs-title">
  <div class="labs-strip">
    <span>Spacefarm Labs</span>
    <span>
      Technical report <b>SFL TR-001</b>
    </span>
  </div>

  <div class="plate">
    <div>
      <h2 id="labs-title">
        Spacefarm
        <br />
        Labs
      </h2>
      <p class="labs-subject">Accessibility research</p>
      <p class="abstract">
        Our initiative for advancing human-computer interaction and accessibility, in any language.
        Two goals for now: find the fastest way to type on a regular keyboard, and make lip reading
        software better on everyday computers and phones.
      </p>
      <a class="labs-cta caps" href={href}>
        Read the report <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div class="figs">
      <figure>
        <FigKeyboard id="cover-keyboard" />
        <figcaption class="labs-caption">
          <b>Fig. 1.</b> A regular keyboard. Key pitch 19 mm.
        </figcaption>
      </figure>
      <figure>
        <FigVisemes id="cover-visemes" />
        <figcaption class="labs-caption">
          <b>Fig. 2.</b> Mouth shapes for six sounds.
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="labs-strip foot">
    <span>Human-computer interaction</span>
    <span class="labs-stamp">Distribution unlimited</span>
    <span>November 2026</span>
  </div>
</section>

<style>
  .labs-cover {
    /* The paper the figure's callout discs are punched out of */
    --fig-bg: var(--labs-orange);
    padding: 0 1.1rem;
    color: var(--labs-black);
    background: var(--labs-orange);
    border-radius: 2px;
    box-shadow:
      0 1px 2px rgb(11 11 12 / 0.12),
      0 18px 40px -18px rgb(255 79 0 / 0.55);
  }
  .labs-cover ::selection {
    color: var(--labs-orange);
    background: var(--labs-black);
  }
  @media (min-width: 34rem) {
    .labs-cover {
      padding: 0 1.6rem;
    }
  }

  .plate {
    display: grid;
    gap: 1.8rem;
    padding: 1.6rem 0 1.8rem;
  }
  @media (min-width: 48rem) {
    .plate {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 2rem;
      align-items: end;
      padding: 2rem 0;
    }
  }

  h2 {
    margin: 0 0 1.1rem -0.04em;
    font-family: var(--font-head);
    font-size: clamp(2.4rem, 15.5vw, 4.9rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }
  .abstract {
    max-width: 21rem;
    margin: 1.2rem 0 1.4rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .figs {
    display: grid;
    gap: 1.4rem;
    max-width: 16rem;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 0.7rem;
    padding-top: 0.5rem;
    border-top: 1px solid currentColor;
  }
</style>
