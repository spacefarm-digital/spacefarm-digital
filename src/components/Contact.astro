---
// The contact button jumps to warp when hovered: a sky opens up inside it and stars streak past
// the label, out from the centre, while the label itself stays put. Leaving the button drops it
// out of warp, the stars freezing and fading where they are. The stars are static markup, each
// with its own ray, speed and phase, from a seeded generator so every build draws the same sky.
// Under reduced motion the sky still opens, but as still pinpoints that only twinkle.
const seeded = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = seeded(2017);
const count = 40;
const stars = Array.from({ length: count }, (_, i) => {
  const angle = (i * 360) / count + (rand() - 0.5) * 12;
  const duration = 650 + rand() * 500;
  return {
    angle: angle.toFixed(1),
    size: (1 + rand() * 0.9).toFixed(2),
    // How far along its ray the star flies, in px from the button's centre (the edges clip it)
    from: (6 + rand() * 12).toFixed(1),
    to: (64 + rand() * 24).toFixed(1),
    stretch: (10 + rand() * 16).toFixed(1),
    duration: duration.toFixed(0),
    // A negative delay starts each star mid-flight, so the sky is full the moment it opens
    delay: (-rand() * duration).toFixed(0),
    // Where the star rests under reduced motion, and the phase of its twinkle
    rest: (10 + rand() * 42).toFixed(1),
    twinkle: (-rand() * 3000).toFixed(0),
  };
});
---

<section class="mx-auto mb-16 flex max-w-lg sm:mb-24 flex-wrap justify-center">
  <p>Feel like building something exciting together? Drop us a line.</p>
  <a class="btn warp inline-block" href="mailto:hello@spacefarm.digital">
    <span class="sky" aria-hidden="true">
      {stars.map((s) => (
        <i
          class="star"
          style={`--angle: ${s.angle}deg; --size: ${s.size}px; --from: ${s.from}px; --to: ${s.to}px; --stretch: ${s.stretch}; --duration: ${s.duration}ms; --delay: ${s.delay}ms; --rest: ${s.rest}px; --twinkle: ${s.twinkle}ms`}
        />
      ))}
    </span>
    <span class="label">Contact</span>
  </a>
</section>

<style>
  .warp {
    position: relative;
    overflow: hidden;
    transition:
      transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .warp:hover,
  .warp:focus-visible {
    transform: translateY(-3px) scale(1.03);
    box-shadow: var(--shadow-btn-hover);
  }

  /* The sky: deep space opening up behind the label, darkest at the centre where the stars come from */
  .sky {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      55% 130% at 50% 50%,
      #2110b8 0%,
      #3e24ec 65%,
      var(--color-brand) 100%
    );
    opacity: 0;
    transition: opacity 250ms ease-out;
    z-index: 0;
  }
  .label {
    position: relative;
    z-index: 1;
  }
  .warp:hover .sky,
  .warp:focus-visible .sky {
    opacity: 1;
    transition-duration: 350ms;
  }

  /* Each star sits at the centre, turned onto its own ray; flying is a translate along that ray */
  .star {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 999px;
    /* Bright at the head (the outward end), fading down the tail once stretched */
    background: linear-gradient(to right, rgb(255 255 255 / 0), #fff 70%);
    opacity: 0;
    transform-origin: 0 50%;
    transform: rotate(var(--angle)) translateX(var(--rest));
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The animation is paused at rest and runs while hovered, so leaving freezes the stars mid-streak
       while the sky fades, like dropping out of warp */
    .star {
      animation: streak var(--duration) cubic-bezier(0.4, 0, 1, 1) var(--delay) infinite paused;
    }
    .warp:hover .star,
    .warp:focus-visible .star {
      animation-play-state: running;
    }
    @keyframes streak {
      0% {
        opacity: 0;
        transform: rotate(var(--angle)) translateX(var(--from)) scaleX(1);
      }
      30% {
        opacity: 0.9;
      }
      100% {
        opacity: 1;
        transform: rotate(var(--angle)) translateX(var(--to)) scaleX(var(--stretch));
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* A still sky: the stars appear as pinpoints and only breathe, nothing travels */
    .warp:hover .star,
    .warp:focus-visible .star {
      animation: twinkle 3s ease-in-out var(--twinkle) infinite alternate;
    }
    @keyframes twinkle {
      from {
        opacity: 0.5;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
