---
import { getCollection } from 'astro:content';
import type { ProjectColor } from '../content.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  { key: 'current', title: 'Currently working on' },
  { key: 'recent', title: 'Recent work' },
] as const;

// Spelled out so Tailwind sees every class it has to emit.
const colorClass: Record<ProjectColor, string> = {
  spacefarm: 'text-spacefarm',
  proctest: 'text-proctest',
  consentio: 'text-consentio',
  dribbble: 'text-dribbble',
  medium: 'text-medium',
  kutia: 'text-kutia',
  timeheroes: 'text-timeheroes',
  bbteam: 'text-bbteam',
  react: 'text-react',
  netlify: 'text-netlify',
  improved: 'text-improved',
  hckrs: 'text-hckrs',
  limbix: 'text-limbix',
};

// The 2017 grid: one column, two from the sm breakpoint, half-rem gutters.
const col = 'flex flex-none basis-full max-w-full px-2 sm:basis-1/2 sm:max-w-1/2';
const card = 'relative block w-full rounded-card bg-white p-4 shadow-card';
const cardTitle = 'text-f4 font-head mb-1 leading-[1.2] font-medium';
---

{groups.map((group) => (
  <section class="mb-8">
    <h2 class="text-f5 mb-4 inline-block bg-selection px-2 py-1 leading-normal font-semibold">
      {group.title}
    </h2>
    <ul class="-mx-2 mb-4 flex flex-wrap">
      {projects
        .filter((project) => project.data.group === group.key)
        .map(({ data }) =>
          data.nda ? (
            <li class={`${col} relative mb-4`}>
              <div class={card}>
                <h3 class={`${cardTitle} ${colorClass[data.color]}`}>{data.title}</h3>
                <div class="text-f2 font-head relative mb-8 flex h-full items-center justify-center pb-4 text-center leading-none font-medium">
                  <span class="relative top-[.2rem] mr-2 block">😶</span>
                  <span class="block">NDA</span>
                </div>
              </div>
            </li>
          ) : data.link ? (
            <li class={col}>
              <a class={`${card} lift mb-4`} href={data.link} target="_blank">
                <h3 class={`${cardTitle} ${colorClass[data.color]}`}>{data.title}</h3>
                <p class="mb-1">{data.description}</p>
              </a>
            </li>
          ) : (
            <li class={col}>
              <div class={`${card} mb-4`}>
                <h3 class={`${cardTitle} ${colorClass[data.color]}`}>{data.title}</h3>
                <p class="mb-1">{data.description}</p>
              </div>
            </li>
          ),
        )}
    </ul>
  </section>
))}
