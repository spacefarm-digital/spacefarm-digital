---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import PaperShader from './PaperShader.astro';
import photo from '../assets/team/darin-kalina.jpg';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

// The shader samples its own copy of the photo; the <Image> underneath is the no-WebGL fallback
// and what hovering reveals.
const shaderPhoto = await getImage({ src: photo, width: 1024, format: 'jpg' });
---

<section class="mb-8">
  <h2 class="label text-f5 mb-4 inline-block bg-selection px-2 py-1 leading-normal font-semibold">
    Team
  </h2>
  <figure class="team-photo relative m-0 mb-6 aspect-[3/2] overflow-hidden">
    <Image
      src={photo}
      alt="Darin and Kalina"
      widths={[736, 1024]}
      sizes="(min-width: 48rem) 736px, 100vw"
      class="block h-full w-full object-cover"
    />
    <PaperShader preset="halftone" image={shaderPhoto.src} class="halftone" />
  </figure>
  <ul class="-mx-2 flex flex-wrap">
    {team.map(({ data }) => (
      <li class="flex max-w-full flex-none basis-full px-2 sm:max-w-1/2 sm:basis-1/2">
        <div class="relative mb-8">
          <h3 class="text-f4 font-head mb-1 leading-[1.2] font-medium">{data.name}</h3>
          <span class="mb-2 block font-semibold">{data.title}</span>
          <p class="mb-0">{data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
