---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

// A photo is src/assets/team/<id>.{jpg,png,webp}; without one, the slot shows the person's initials.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/team/*.{jpg,jpeg,png,webp}',
  {
    eager: true,
  },
);
const photoFor = (id: string) =>
  Object.entries(photos).find(([path]) => path.split('/').pop()?.split('.')[0] === id)?.[1].default;
const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');
---

<section class="mb-8">
  <h2 class="label text-f5 mb-4 inline-block bg-selection px-2 py-1 leading-normal font-semibold">
    Team
  </h2>
  <ul class="-mx-2 flex flex-wrap">
    {team.map(({ id, data }) => {
      const photo = photoFor(id);
      return (
        <li class="flex max-w-full flex-none basis-full px-2 sm:max-w-1/2 sm:basis-1/2">
          <div class="relative mb-8">
            <div class="team-photo mb-4 h-28 w-28 overflow-hidden">
              {photo ? (
                <Image
                  src={photo}
                  alt={data.name}
                  width={224}
                  height={224}
                  class="block h-full w-full object-cover"
                />
              ) : (
                <span
                  class="text-f4 font-head flex h-full w-full items-center justify-center bg-selection font-medium text-spacefarm"
                  aria-hidden="true"
                >
                  {initials(data.name)}
                </span>
              )}
            </div>
            <h3 class="text-f4 font-head mb-1 leading-[1.2] font-medium">{data.name}</h3>
            <span class="mb-2 block font-semibold">{data.title}</span>
            <p class="mb-0">{data.description}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>
