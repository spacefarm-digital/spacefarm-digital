---
import Logo from '../assets/logo.svg';
import PaperShader from './PaperShader.astro';
---

<section class="relative pt-16 pb-8">
  <PaperShader preset="glow" class="glow" />
  <h1 class="text-f3 sm:text-f1 font-head mb-4 max-w-lg leading-none font-medium text-spacefarm sm:mb-8">
    <span class="mr-[.25em] inline-block h-[.65em] w-[.65em] align-[-2.5%]">
      <Logo />
    </span>
    spacefarm
  </h1>
  <p class="max-w-lg">
    Spacefarm is a small product design and development shop. We build our own apps and help great
    startups with theirs.
  </p>
</section>
