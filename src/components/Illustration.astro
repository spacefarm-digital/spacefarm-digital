---
import source from '../assets/illustration.svg?raw';
import { buildFarm } from './farm';

// The 2017 farm, extended sideways at build time so it spans any viewport. See farm.ts.
const farm = buildFarm(source);
---

<div class="relative" aria-hidden="true">
  <div class="illustration relative">
    <Fragment set:html={farm} />
  </div>
</div>
