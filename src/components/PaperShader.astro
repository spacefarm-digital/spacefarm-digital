---
// A Paper Shaders (https://github.com/paper-design/shaders) canvas that fills its parent.
// `preset` picks one of the uses on this site; the params live in the script below so
// the HTML carries only a name (and, for image effects, the image's URL).
// Static presets render once and cost nothing afterwards.
interface Props {
  preset: 'paper' | 'glow' | 'veil' | 'halftone' | 'wtheic' | 'agents' | 'sunlight' | 'chopchop';
  image?: string;
  class?: string;
}

const { preset, image, class: className } = Astro.props;
---

<div class={className} data-paper-shader={preset} data-image={image} aria-hidden="true"></div>

<script>
  import {
    ShaderMount,
    HalftoneDotsGrids,
    HalftoneDotsTypes,
    halftoneDotsFragmentShader,
    emptyPixel,
    ShaderFitOptions,
    defaultObjectSizing,
    getShaderColorFromString,
    meshGradientFragmentShader,
    staticMeshGradientFragmentShader,
    type ShaderMountUniforms,
  } from '@paper-design/shaders';
  import { appPresets, type Preset } from './app-shaders';

  const sizing = (overrides: Partial<Record<string, number>> = {}): ShaderMountUniforms => ({
    u_fit: ShaderFitOptions[defaultObjectSizing.fit],
    u_scale: defaultObjectSizing.scale,
    u_rotation: defaultObjectSizing.rotation,
    u_offsetX: defaultObjectSizing.offsetX,
    u_offsetY: defaultObjectSizing.offsetY,
    u_originX: defaultObjectSizing.originX,
    u_originY: defaultObjectSizing.originY,
    u_worldWidth: defaultObjectSizing.worldWidth,
    u_worldHeight: defaultObjectSizing.worldHeight,
    ...overrides,
  });
  const colors = (list: string[]) => ({
    u_colors: list.map(getShaderColorFromString),
    u_colorsCount: list.length,
  });

  const stillness = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const presets: Record<string, (el: HTMLElement) => Preset> = {
    // The page background: a slow mesh gradient led by the brand purple (it takes two of the five
    // points), with white and lighter magenta and blue. Settings tuned on shaders.paper.design.
    paper: () => ({
      fragment: meshGradientFragmentShader,
      speed: stillness ? 0 : 0.22,
      pixelRatio: 1,
      uniforms: {
        ...colors(['#ffffff', '#5538fa', '#f58fc8', '#5538fa', '#7d86e8']),
        u_distortion: 0.66,
        u_swirl: 0.51,
        u_grainMixer: 0,
        u_grainOverlay: 0,
        ...sizing({ u_fit: ShaderFitOptions.cover, u_scale: 2.24 }),
      },
    }),
    // The light behind the wordmark: a slow mesh gradient in the brand colours.
    glow: () => ({
      fragment: meshGradientFragmentShader,
      speed: stillness ? 0 : 0.35,
      uniforms: {
        ...colors(['#f7f8fa', '#5538fa', '#d2defa', '#5cffa0', '#f7f8fa']),
        u_distortion: 0.9,
        u_swirl: 0.25,
        u_grainMixer: 0,
        u_grainOverlay: 0,
        ...sizing({ u_fit: ShaderFitOptions.cover }),
      },
    }),
    // What hides behind the NDA card: a still gradient seen through frosted glass.
    veil: () => ({
      fragment: staticMeshGradientFragmentShader,
      speed: 0,
      uniforms: {
        ...colors(['#7080d4', '#d2defa', '#5538fa', '#ffffff']),
        u_positions: 12,
        u_waveX: 0.8,
        u_waveXShift: 0.3,
        u_waveY: 0.9,
        u_waveYShift: 0.5,
        u_mixing: 0.8,
        u_grainMixer: 0.15,
        u_grainOverlay: 0.1,
        ...sizing({ u_fit: ShaderFitOptions.cover, u_rotation: 300 }),
      },
    }),
    // The team photo as a print: brand-purple halftone dots on paper. Static.
    halftone: (el) => {
      const image = new Image();
      image.src = el.dataset.image ?? emptyPixel;
      return {
        fragment: halftoneDotsFragmentShader,
        speed: 0,
        uniforms: {
          u_image: image,
          u_imageAspectRatio: 1, // set from the decoded image in mount()
          u_colorBack: getShaderColorFromString('#f7f8fa'),
          u_colorFront: getShaderColorFromString('#5538fa'),
          u_size: 0.12,
          u_radius: 1.25,
          u_contrast: 0.3,
          u_originalColors: false,
          u_inverted: false,
          u_grainMixer: 0,
          u_grainOverlay: 0,
          u_grainSize: 0.5,
          u_grid: HalftoneDotsGrids.hex,
          u_type: HalftoneDotsTypes.gooey,
          ...sizing({ u_fit: ShaderFitOptions.cover }),
        },
      };
    },
    // The four "Our apps" scenes live in app-shaders.ts next to their hover states
    ...appPresets,
  };

  async function mount(el: HTMLElement) {
    const make = presets[el.dataset.paperShader ?? ''];
    if (!make) return;
    const { fragment, uniforms, speed, pixelRatio } = make(el);
    try {
      // Texture uniforms have to be decoded before the mount reads them
      for (const value of Object.values(uniforms)) {
        if (value instanceof HTMLImageElement) await value.decode();
      }
      if (uniforms.u_image instanceof HTMLImageElement && el.dataset.image) {
        const { naturalWidth, naturalHeight } = uniforms.u_image;
        uniforms.u_imageAspectRatio = naturalWidth / naturalHeight;
      }
      new ShaderMount(el, fragment, uniforms, undefined, speed, 0, pixelRatio);
    } catch (error) {
      // No WebGL: the CSS colours underneath do the job on their own.
      console.warn('Paper shader skipped', error);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-paper-shader]').forEach(mount);
</script>
