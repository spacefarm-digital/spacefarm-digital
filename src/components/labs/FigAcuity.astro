---
// Fig. 2: a tumbling-E acuity chart. Every E is the same five-by-five glyph, turned and scaled.
const rows = [
  { size: 46, turns: [0] },
  { size: 32, turns: [1, 3] },
  { size: 22, turns: [2, 0, 1] },
  { size: 15, turns: [3, 1, 0, 2] },
  { size: 10, turns: [0, 2, 3, 1, 0] },
  { size: 6.5, turns: [1, 0, 2, 3, 1, 2] },
];
const cx = 172;
let y = 14;
const placed = rows.map((row, i) => {
  const gap = row.size * 0.9;
  const width = row.turns.length * row.size + (row.turns.length - 1) * gap;
  const top = y;
  y += row.size + 16;
  return {
    n: i + 1,
    top,
    size: row.size,
    es: row.turns.map((t, j) => ({ x: cx - width / 2 + j * (row.size + gap), turn: t * 90 })),
  };
});
const height = y + 6;
---

<svg
  class="labs-fig"
  viewBox={`0 0 320 ${height}`}
  fill="none"
  role="img"
  aria-labelledby="acuity-t"
>
  <title id="acuity-t">
    An eye chart of the letter E in six rows, each row smaller than the last and each letter turned
    a different way.
  </title>
  <defs>
    <path id="acuity-e" d="M0 0H5V1H1V2H5V3H1V4H5V5H0Z" fill="currentColor"></path>
  </defs>
  {placed.map((row) => (
    <g>
      <text x="24" y={row.top + row.size / 2 + 4}>
        {row.n}
      </text>
      <path d={`M40 ${row.top + row.size / 2}H52`} stroke="currentColor" stroke-width="0.75" />
      {row.es.map((e) => (
        <g
          transform={`translate(${e.x} ${row.top}) scale(${row.size / 5}) rotate(${e.turn} 2.5 2.5)`}
        >
          <use href="#acuity-e" />
        </g>
      ))}
    </g>
  ))}
  <path d={`M300 14V${height - 22}`} stroke="currentColor" stroke-width="0.75"></path>
  <path d={`M300 ${height - 22}l-2.6 -7h5.2z`} fill="currentColor"></path>
  <path d="M294 14H306" stroke="currentColor" stroke-width="0.75"></path>
</svg>
