---
// Fig. 1: one-handed thumb reach on a phone, drawn like a reach-envelope plate from a human-factors
// manual. Ink is currentColor; --fig-bg is the paper it is printed on (for the callout discs).
interface Props {
  /** Unique per page: the drawing's pattern, clip and mask are referenced by id */
  id?: string;
}
const { id = 'reach' } = Astro.props;
const P = { x: 252, y: 330 }; // the thumb's pivot, at the lower right edge of the screen
---

<svg class="labs-fig" viewBox="0 0 320 408" fill="none" role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>
    A phone held in the right hand. Arcs from the thumb mark three zones of the screen: natural
    reach near the thumb, stretch in the middle, and out of reach in the far top corner.
  </title>
  <defs>
    <pattern
      id={`${id}-hatch`}
      width="7"
      height="7"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="1"></line>
    </pattern>
    <clipPath id={`${id}-screen`}>
      <rect x="98" y="46" width="154" height="324" rx="17"></rect>
    </clipPath>
    <mask id={`${id}-far`}>
      <rect x="0" y="0" width="320" height="408" fill="#fff"></rect>
      <circle cx={P.x} cy={P.y} r="222" fill="#000"></circle>
    </mask>
  </defs>

  <!-- The phone -->
  <rect
    x="90"
    y="38"
    width="170"
    height="340"
    rx="25"
    stroke="currentColor"
    stroke-width="1.75"
  ></rect>
  <rect
    x="98"
    y="46"
    width="154"
    height="324"
    rx="17"
    stroke="currentColor"
    stroke-width="0.75"
  ></rect>
  <rect
    x="153"
    y="55"
    width="44"
    height="11"
    rx="5.5"
    stroke="currentColor"
    stroke-width="0.75"
  ></rect>

  <!-- Reach zones, clipped to the screen -->
  <g clip-path={`url(#${id}-screen)`}>
    <rect
      x="98"
      y="46"
      width="154"
      height="324"
      fill={`url(#${id}-hatch)`}
      mask={`url(#${id}-far)`}
      stroke="none"
    ></rect>
    <circle cx={P.x} cy={P.y} r="222" stroke="currentColor" stroke-width="1.25"></circle>
    <circle
      cx={P.x}
      cy={P.y}
      r="128"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-dasharray="6 4"
    ></circle>
  </g>

  <!-- The pivot -->
  <circle
    cx={P.x}
    cy={P.y}
    r="5"
    stroke="currentColor"
    stroke-width="1.25"
    fill="var(--fig-bg)"
  ></circle>
  <path
    d={`M${P.x - 11} ${P.y}H${P.x + 11}M${P.x} ${P.y - 11}V${P.y + 11}`}
    stroke="currentColor"
    stroke-width="0.75"
  ></path>
  <path d={`M${P.x + 8} ${P.y + 8}L286 364H306`} stroke="currentColor" stroke-width="0.75"></path>
  <text x="288" y="360">
    P
  </text>

  <!-- Callouts -->
  <g>
    <circle
      cx="124"
      cy="84"
      r="12"
      fill="var(--fig-bg)"
      stroke="currentColor"
      stroke-width="1.25"
    ></circle>
    <text x="124" y="88.6" text-anchor="middle" class="mark">
      C
    </text>
    <circle
      cx="150"
      cy="212"
      r="12"
      fill="var(--fig-bg)"
      stroke="currentColor"
      stroke-width="1.25"
    ></circle>
    <text x="150" y="216.6" text-anchor="middle" class="mark">
      B
    </text>
    <circle
      cx="208"
      cy="296"
      r="12"
      fill="var(--fig-bg)"
      stroke="currentColor"
      stroke-width="1.25"
    ></circle>
    <text x="208" y="300.6" text-anchor="middle" class="mark">
      A
    </text>
  </g>

  <!-- Dimensions -->
  <g stroke="currentColor" stroke-width="0.75">
    <path d="M90 30V8M260 30V8M90 16H260"></path>
    <path d="M90 16l7 -2.6v5.2zM260 16l-7 -2.6v5.2z" fill="currentColor" stroke="none"></path>
    <path d="M82 38H44M82 378H44M52 38V378"></path>
    <path d="M52 38l-2.6 7h5.2zM52 378l-2.6 -7h5.2z" fill="currentColor" stroke="none"></path>
  </g>
  <rect x="155" y="9" width="40" height="14" fill="var(--fig-bg)"></rect>
  <text x="175" y="20" text-anchor="middle">
    72
  </text>
  <rect x="38" y="200" width="28" height="16" fill="var(--fig-bg)"></rect>
  <text x="52" y="212" text-anchor="middle">
    150
  </text>
  <text x="90" y="402">
    DIMENSIONS IN MM
  </text>
</svg>
