---
const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/timeline/`;
---

<section class="mb-8">
  <h2 class="label text-f5 mb-4 inline-block bg-selection px-2 py-1 leading-normal font-semibold">
    Old work from 10y ago
  </h2>
  <a class="lift relative mb-4 block w-full rounded-card bg-card p-4 shadow-card" href={href}>
    <h3 class="text-f4 font-head mb-1 leading-[1.2] font-medium text-spacefarm">
      Projects timeline→
    </h3>
    <p class="mb-1">Some projects from a previous life</p>
  </a>
</section>
